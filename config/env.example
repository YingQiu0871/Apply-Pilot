# Copy to .env (same folder) and fill in the keys you have. Missing keys only
# disable that one source; everything else keeps working.
# France Travail "Offres d'emploi v2": https://francetravail.io (free account, app with the api_offresdemploiv2 scope)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna: https://developer.adzuna.com (free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about (free key by email)
JOOBLE_API_KEY=
# Careerjet partner id: https://www.careerjet.com/partners (free)
CAREERJET_AFFID=
# Web search: Brave Search API https://api.search.brave.com (monthly free credit, card required)
BRAVE_API_KEY=
# Optional alternatives: Mojeek API, or your own SearXNG instance with JSON output enabled
MOJEEK_API_KEY=
SEARXNG_URL=
# DeepSeek for "apply-pilot eval run|pipeline --provider deepseek"
DEEPSEEK_API_KEY=
